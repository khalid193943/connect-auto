# Base de données Postgres (ajoutée automatiquement par l'intégration Neon de Vercel)
DATABASE_URL=
# Stockage des photos (ajouté automatiquement par Vercel Blob)
BLOB_READ_WRITE_TOKEN=
# Mot de passe du premier compte admin (identifiant : fouad)
ADMIN_PASSWORD=
# Adresse définitive du site, quand le nom de domaine est prêt (active l'indexation Google)
SITE_URL=

# --- Remplissage automatique d'un véhicule par sa plaque (facultatif, payant à la recherche) ---
# Un seul des deux fournisseurs suffit. Sans aucun des deux, l'option s'affiche « à activer ».
# apiplaqueimmatriculation.com (français, données carte grise SIV)
PLAQUE_API_TOKEN=
# regcheck.org.uk (opération CheckFrance, 10 crédits d'essai à l'inscription)
REGCHECK_USERNAME=
